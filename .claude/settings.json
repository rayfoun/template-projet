{
  "permissions": {
    "allow": [
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(git branch:*)", "Bash(git switch:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(git fetch:*)", "Bash(git pull:*)", "Bash(git push:*)", "Bash(git tag:*)",
      "Bash(gh auth status:*)", "Bash(gh repo view:*)", "Bash(gh repo create:*)",
      "Bash(gh repo edit:*)", "Bash(gh pr:*)", "Bash(gh issue:*)", "Bash(gh release:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)", "Bash(git merge:*)", "Bash(git rebase:*)",
      "Bash(gh repo delete:*)", "Bash(gh pr merge --admin:*)"
    ]
  }
}
